{
  "name": "minecraftjs",
  "version": "1.0.0",
  "description": "Web-based Minecraft 1.8.9 client with WebSocket proxy",
  "scripts": {
    "start": "node proxy.js",
    "dev": "node proxy.js",
    "assets": "node tools/build.js assets",
    "build": "node tools/build.js html",
    "test:adventure-tooltips": "node tools/adventure-tooltip-fixtures.mjs --check && node --test tools/test-adventure-tooltips.mjs tools/test-adventure.mjs",
    "test:resource-layers": "node --test tools/test-resource-layers.mjs tools/test-resource-image-namespaces.mjs tools/test-font-spacing.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pako": "^2.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "ffmpeg-static": "^5.3.0"
  }
}
